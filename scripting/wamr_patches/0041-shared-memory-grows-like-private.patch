+/* rive: MSVC lacks the GCC builtins, and it only builds wamrc, which never
+   runs a parallel call */
+#if defined(CLANG_GCC_HAS_ATOMIC_BUILTIN)
+#define RIVE_MEMORY_FROZEN(memory) \
+    __atomic_load_n(&(memory)->rive_frozen, __ATOMIC_SEQ_CST)
+#define RIVE_SET_MEMORY_FROZEN(memory, frozen) \
+    __atomic_store_n(&(memory)->rive_frozen, (frozen), __ATOMIC_SEQ_CST)
+#else
+#define RIVE_MEMORY_FROZEN(memory) ((memory)->rive_frozen)
+#define RIVE_SET_MEMORY_FROZEN(memory, frozen) \
+    ((memory)->rive_frozen = (frozen))
+#endif
