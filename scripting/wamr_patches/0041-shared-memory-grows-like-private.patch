@@ -124,9 +124,14 @@ struct WASMMemoryInstance {
          0: non-shared memory, > 0: shared memory */
     bh_atomic_16_t ref_count;
 
+    /* rive: set while a parallel call runs, when growing could move the
+       memory under its members; a padding byte, so compiled code's offsets
+       stay */
+    uint8 rive_frozen;
+
     /* Four-byte paddings to ensure the layout of WASMMemoryInstance is the same
      * in both 64-bit and 32-bit */
-    uint8 _paddings[4];
+    uint8 _paddings[3];
 
     /* Number bytes per page */
