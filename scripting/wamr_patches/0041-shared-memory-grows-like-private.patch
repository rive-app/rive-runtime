+void
+wasm_runtime_rive_freeze_memory(WASMModuleInstanceCommon *module_inst,
+                                bool frozen)
+{
+    WASMMemoryInstance *memory =
+        wasm_get_default_memory((WASMModuleInstance *)module_inst);
+
+    if (memory)
+        RIVE_SET_MEMORY_FROZEN(memory, frozen ? 1 : 0);
+}
