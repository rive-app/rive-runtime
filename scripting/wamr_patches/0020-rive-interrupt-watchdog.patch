 /**
+ * rive: ask the interpreter running on exec_env to trap at its next branch
+ * or call. Safe from any thread; the flag stays set until cleared.
+ */
+WASM_RUNTIME_API_EXTERN void
+wasm_runtime_rive_interrupt(wasm_exec_env_t exec_env);
+
+/**
+ * rive: clear a pending interrupt before the next call into the module.
+ */
+WASM_RUNTIME_API_EXTERN void
+wasm_runtime_rive_clear_interrupt(wasm_exec_env_t exec_env);
+
+/**
  * Set custom data to WASM module instance.
  * Note:
  *  If WAMR_BUILD_LIB_PTHREAD is enabled, this API
--- a/core/iwasm/common/wasm_runtime_common.c
+++ b/core/iwasm/common/wasm_runtime_common.c
@@ -3267,6 +3267,20 @@
     bh_assert(module_inst_comm->module_type == Wasm_Module_Bytecode
               || module_inst_comm->module_type == Wasm_Module_AoT);
     wasm_runtime_set_exception(module_inst_comm, NULL);
+}
+
+void
+wasm_runtime_rive_interrupt(WASMExecEnv *exec_env)
+{
+    WASM_SUSPEND_FLAGS_FETCH_OR(exec_env->suspend_flags,
+                                WASM_SUSPEND_FLAG_TERMINATE);
+}
+
+void
+wasm_runtime_rive_clear_interrupt(WASMExecEnv *exec_env)
+{
+    WASM_SUSPEND_FLAGS_FETCH_AND(exec_env->suspend_flags,
+                                 ~WASM_SUSPEND_FLAG_TERMINATE);
 }
 
