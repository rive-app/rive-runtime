@@ -616,6 +682,7 @@ wasm_interp_get_frame_ref(WASMInterpFrame *frame)
                         operation GET_OPERAND(src_type2, src_op_type, 0)); \
         frame_ip += 6;                                                     \
     } while (0)
+#endif
 
