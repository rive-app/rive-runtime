+static bool
+record_direct_call(AOTFuncContext *func_ctx, LLVMValueRef call, uint32 callee)
+{
+    if (func_ctx->rive_direct_call_count
+        == func_ctx->rive_direct_call_capacity) {
+        uint32 capacity = func_ctx->rive_direct_call_capacity * 2 + 8;
+        AOTDirectCall *calls = wasm_runtime_realloc(
+            func_ctx->rive_direct_calls, sizeof(AOTDirectCall) * capacity);
+        if (!calls) {
+            aot_set_last_error("allocate memory failed.");
+            return false;
+        }
+        func_ctx->rive_direct_calls = calls;
+        func_ctx->rive_direct_call_capacity = capacity;
+    }
+    func_ctx->rive_direct_calls[func_ctx->rive_direct_call_count].call = call;
+    func_ctx->rive_direct_calls[func_ctx->rive_direct_call_count++].callee =
+        callee;
+    return true;
+}
