From: rive
Subject: [PATCH 0056] direct calls skip the callee's entry check

Every compiled function sits behind an entry stub that checks the native
stack against its own frame, and every call between compiled functions went
through it. A direct call now enters the callee's body when the callee
cannot reach the caller back, which the call graph's strongly connected
components show once every function is compiled. The callee's stack need
folds into the caller's stack size, so the caller's entry check covers each
callee it enters directly. Calls within a recursive group, indirect calls
and calls from the host still go through the stub, so unbounded recursion
still meets a check.

--- a/core/iwasm/compilation/aot_compiler.c
+++ b/core/iwasm/compilation/aot_compiler.c
@@ -4013,6 +4013,97 @@ verify_module(AOTCompContext *comp_ctx)
     return true;
 }
 
+/* rive patch: a direct call whose callee cannot reach the caller back goes
+   to the callee's body. The callee's need then folds into the caller's
+   stack size, so the caller's entry check covers both, and recursion keeps
+   a check on every call. Tarjan's order puts every callee first. */
+static bool
+send_direct_calls_past_entry_checks(AOTCompContext *comp_ctx)
+{
+    AOTFuncContext **func_ctxes = comp_ctx->func_ctxes;
+    uint32 n = comp_ctx->func_ctx_count, next = 0, depth = 0, top = 0;
+    uint32 components = 0, ordered = 0, root, i, j;
+    uint64 size = sizeof(uint32) * (uint64)n * 6;
+    uint32 *buf = NULL, *order = NULL;
+    uint32 *index, *low, *component, *stack, *path, *edge;
+
+    if (n == 0)
+        return true;
+    if (size >= UINT32_MAX || !(buf = wasm_runtime_malloc((uint32)size))
+        || !(order = wasm_runtime_malloc(sizeof(uint32) * n))) {
+        if (buf)
+            wasm_runtime_free(buf);
+        aot_set_last_error("allocate memory failed.");
+        return false;
+    }
+    index = buf;
+    low = index + n;
+    component = low + n;
+    stack = component + n;
+    path = stack + n;
+    edge = path + n;
+    for (i = 0; i < n; i++) {
+        index[i] = UINT32_MAX;
+        component[i] = UINT32_MAX;
+    }
+
+    for (root = 0; root < n; root++) {
+        if (index[root] != UINT32_MAX)
+            continue;
+        index[root] = low[root] = next++;
+        stack[top++] = root;
+        path[depth] = root;
+        edge[depth++] = 0;
+        while (depth > 0) {
+            uint32 v = path[depth - 1];
+            AOTFuncContext *func_ctx = func_ctxes[v];
+            if (edge[depth - 1] < func_ctx->rive_direct_call_count) {
+                uint32 w =
+                    func_ctx->rive_direct_calls[edge[depth - 1]++].callee;
+                if (index[w] == UINT32_MAX) {
+                    index[w] = low[w] = next++;
+                    stack[top++] = w;
+                    path[depth] = w;
+                    edge[depth++] = 0;
+                }
+                else if (component[w] == UINT32_MAX && index[w] < low[v]) {
+                    low[v] = index[w];
+                }
+                continue;
+            }
+            if (low[v] == index[v]) {
+                uint32 w;
+                do {
+                    w = stack[--top];
+                    component[w] = components;
+                    order[ordered++] = w;
+                } while (w != v);
+                components++;
+            }
+            if (--depth > 0 && low[v] < low[path[depth - 1]])
+                low[path[depth - 1]] = low[v];
+        }
+    }
+
+    for (i = 0; i < n; i++) {
+        AOTFuncContext *func_ctx = func_ctxes[i];
+        for (j = 0; j < func_ctx->rive_direct_call_count; j++) {
+            AOTDirectCall *direct = &func_ctx->rive_direct_calls[j];
+            if (component[direct->callee] == component[i]) {
+                direct->callee = UINT32_MAX;
+                continue;
+            }
+            LLVMSetOperand(direct->call,
+                           (unsigned)LLVMGetNumOperands(direct->call) - 1,
+                           func_ctxes[direct->callee]->func);
+        }
+    }
+
+    wasm_runtime_free(buf);
+    comp_ctx->rive_callee_first = order;
+    return true;
+}
+
 bool
 aot_compile_wasm(AOTCompContext *comp_ctx)
 {
