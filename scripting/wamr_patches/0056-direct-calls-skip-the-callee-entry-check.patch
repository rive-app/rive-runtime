+                    if (callee != UINT32_MAX && stack_sizes[callee] > deepest)
+                        deepest = stack_sizes[callee];
+                }
+                if (UINT32_MAX - stack_sizes[caller] < deepest) {
+                    aot_set_last_error("stack size overflow.");
+                    goto fail;
+                }
+                stack_sizes[caller] += deepest;
+            }
