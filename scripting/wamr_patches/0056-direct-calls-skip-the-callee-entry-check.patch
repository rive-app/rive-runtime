+                 i++) {
+                uint32 caller = comp_ctx->rive_callee_first[i], deepest = 0, j;
+                const AOTFuncContext *func_ctx = comp_ctx->func_ctxes[caller];
+                for (j = 0; j < func_ctx->rive_direct_call_count; j++) {
