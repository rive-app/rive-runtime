diff --git a/core/iwasm/include/wasm_export.h b/core/iwasm/include/wasm_export.h
index 68dfbdd..1e86893 100644
--- a/core/iwasm/include/wasm_export.h
+++ b/core/iwasm/include/wasm_export.h
@@ -2337,10 +2337,28 @@ wasm_runtime_get_module_name(wasm_module_t module);
    checks only an access whose offset and size pass it */
 #define WASM_RIVE_HW_GUARD_SIZE (64 * 1024)
 
+/* rive: in an instantiate error when no address space was left for it */
+#define WASM_RIVE_HW_RESERVE_FAILED "no address space left for hardware bounds"
+
+/* rive: under an address space limit, what reservations leave free */
+#define WASM_RIVE_HW_RESERVE_MARGIN (2 * 1024 * 1024 * 1024ULL)
+
 /* rive: whether module's code skips bounds checks, as its artifact says */
 WASM_RUNTIME_API_EXTERN bool
 wasm_runtime_rive_module_hw_bounds(wasm_module_t module);
 
+/* rive: live hardware bounds reservations */
+WASM_RUNTIME_API_EXTERN uint32_t
+wasm_runtime_rive_hw_reserves(void);
+
+/* rive: what wasm_runtime_rive_limit_hw_reserves takes for the default cap */
+#define WASM_RIVE_HW_RESERVES_DEFAULT UINT32_MAX
+
+/* rive: caps live reservations, by default at half the address space, and
+   returns the cap it replaces */
+WASM_RUNTIME_API_EXTERN uint32_t
+wasm_runtime_rive_limit_hw_reserves(uint32_t limit);
+
