+static LLVMValueRef
+create_tbaa_tag(LLVMContextRef context, LLVMMetadataRef root, const char *name)
+{
+    LLVMMetadataRef zero = LLVMValueAsMetadata(
+        LLVMConstInt(LLVMInt64TypeInContext(context), 0, false));
+    LLVMMetadataRef type_ops[3] = {
+        LLVMMDStringInContext2(context, name, strlen(name)), root, zero
+    };
+    LLVMMetadataRef type = LLVMMDNodeInContext2(context, type_ops, 3);
+    LLVMMetadataRef tag_ops[3] = { type, type, zero };
+    return LLVMMetadataAsValue(context,
+                               LLVMMDNodeInContext2(context, tag_ops, 3));
+}
+
+static void
+create_tbaa_tags(AOTCompContext *comp_ctx)
+{
+    LLVMContextRef context = comp_ctx->context;
+    LLVMMetadataRef root_name = LLVMMDStringInContext2(context, "wamr tbaa", 9);
+    LLVMMetadataRef root = LLVMMDNodeInContext2(context, &root_name, 1);
+    comp_ctx->tbaa_kind = LLVMGetMDKindIDInContext(context, "tbaa", 4);
+    comp_ctx->tbaa_linear = create_tbaa_tag(context, root, "linear memory");
+    comp_ctx->tbaa_mem_info = create_tbaa_tag(context, root, "memory info");
+    comp_ctx->tbaa_global = create_tbaa_tag(context, root, "global");
+}
+
+void
+aot_set_tbaa(AOTCompContext *comp_ctx, LLVMValueRef inst, LLVMValueRef tag)
+{
+    if (tag != NULL)
+        LLVMSetMetadata(inst, comp_ctx->tbaa_kind, tag);
+}
