+/* rive patch: a memory that is not shared moves only inside a call, so a
+   function that calls keeps its memory info in locals between calls */
+static bool
+cache_memory_info(const AOTCompContext *comp_ctx, AOTFuncContext *func_ctx)
+{
+    AOTMemInfo *info = &func_ctx->mem_info[0];
+    LLVMTypeRef bound_type =
+        comp_ctx->pointer_size == sizeof(uint64) ? I64_TYPE : I32_TYPE;
+    LLVMValueRef *fields[8] = {
+        &info->mem_base_addr,           &info->mem_data_size_addr,
+        &info->mem_cur_page_count_addr, &info->mem_bound_check_1byte,
+        &info->mem_bound_check_2bytes,  &info->mem_bound_check_4bytes,
+        &info->mem_bound_check_8bytes,  &info->mem_bound_check_16bytes
+    };
+    LLVMTypeRef types[8] = { OPQ_PTR_TYPE, I64_TYPE,   I32_TYPE,   bound_type,
+                             bound_type,   bound_type, bound_type, bound_type };
+    uint32 i;
+
+    for (i = 0; i < 8; i++) {
+        LLVMValueRef src = *fields[i], slot, value;
+        if (!src)
+            continue;
+        if (!(slot = LLVMBuildAlloca(comp_ctx->builder, types[i], "mem_cache"))
+            || !(value = LLVMBuildLoad2(comp_ctx->builder, types[i], src,
+                                        "mem_info"))
+            || !LLVMBuildStore(comp_ctx->builder, value, slot)) {
+            aot_set_last_error("llvm build memory info cache failed.");
+            return false;
+        }
+        func_ctx->mem_cache_src[func_ctx->mem_cache_count] = src;
+        func_ctx->mem_cache_slot[func_ctx->mem_cache_count] = slot;
+        func_ctx->mem_cache_type[func_ctx->mem_cache_count] = types[i];
+        func_ctx->mem_cache_count++;
+        *fields[i] = slot;
+    }
+    return true;
+}
+
+bool
+aot_refresh_cached_memory_info(AOTCompContext *comp_ctx,
+                               AOTFuncContext *func_ctx)
+{
+    LLVMBasicBlockRef block;
+    LLVMValueRef inst, next, callee;
+    size_t name_len;
+    const char *name;
+    uint32 i;
+
+    if (func_ctx->mem_cache_count == 0)
+        return true;
+
+    for (block = LLVMGetFirstBasicBlock(func_ctx->func); block;
+         block = LLVMGetNextBasicBlock(block)) {
+        for (inst = LLVMGetFirstInstruction(block); inst; inst = next) {
+            next = LLVMGetNextInstruction(inst);
+            if (!LLVMIsACallInst(inst) || !next)
+                continue;
+            callee = LLVMGetCalledValue(inst);
+            if (callee && LLVMIsAFunction(callee)) {
+                name = LLVMGetValueName2(callee, &name_len);
+                if (name_len > 5 && !strncmp(name, "llvm.", 5))
+                    continue;
+            }
+            LLVMPositionBuilderBefore(comp_ctx->builder, next);
+            for (i = 0; i < func_ctx->mem_cache_count; i++) {
+                LLVMValueRef value = LLVMBuildLoad2(
+                    comp_ctx->builder, func_ctx->mem_cache_type[i],
+                    func_ctx->mem_cache_src[i], "mem_info");
+                if (!value
+                    || !LLVMBuildStore(comp_ctx->builder, value,
+                                       func_ctx->mem_cache_slot[i])) {
+                    aot_set_last_error(
+                        "llvm build memory info refresh failed.");
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
