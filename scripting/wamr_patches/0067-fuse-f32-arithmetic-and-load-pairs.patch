+/* rive: entry of a fused float pair in the interpreter's pair tables. The
+   producer is add 0, sub 1, mul 2 or load 3; a sub consumer takes the
+   producer as lhs when a push landed above it, else as rhs. */
+static uint32
+fused_pair_index(uint32 producer, bool consumer_add, bool consumer_mul,
+                 uint8 depth)
+{
+    uint32 consumer = consumer_add ? 0 : consumer_mul ? 3 : depth ? 1 : 2;
+    return producer * 4 + consumer;
