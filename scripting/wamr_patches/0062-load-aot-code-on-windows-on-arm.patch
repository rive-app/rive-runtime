+/* rive patch: arm64 COFF keeps jump tables as offsets, with no relocations,
+   in the one .rdata that holds no constant of its own */
+static bool
+is_coff_arm64_rdata(AOTObjectData *obj_data, LLVMSectionIteratorRef sec_itr,
+                    const char *section_name)
+{
+    LLVMSymbolIteratorRef sym_itr;
+    const char *name;
+    bool holds_constant = false;
+
+    if (strcmp(section_name, ".rdata")
+        || obj_data->target_info.e_machine != IMAGE_FILE_MACHINE_ARM64
+        || !(sym_itr = LLVMObjectFileCopySymbolIterator(obj_data->binary)))
+        return false;
+    while (!holds_constant
+           && !LLVMObjectFileIsSymbolIteratorAtEnd(obj_data->binary, sym_itr)) {
+        name = LLVMGetSymbolName(sym_itr);
+        holds_constant = name
+                         && (str_starts_with(name, "__real@")
+                             || str_starts_with(name, "__xmm@")
+                             || str_starts_with(name, "__ymm@"))
+                         && LLVMGetSectionContainsSymbol(sec_itr, sym_itr);
+        LLVMMoveToNextSymbol(sym_itr);
+    }
+    LLVMDisposeSymbolIterator(sym_itr);
+    return !holds_constant;
+}
