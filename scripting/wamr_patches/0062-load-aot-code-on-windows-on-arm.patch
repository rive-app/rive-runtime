+/* rive patch: whether a relocation is a call to aot_func_internal#n that
+   aot_emit_text_section applies, as Windows objects keep them, arm64 too */
+static bool
+is_windows_internal_call(const AOTObjectData *obj_data,
+                         const AOTRelocationGroup *relocation_group,
+                         const AOTRelocation *relocation)
+{
+    const char *arch = obj_data->comp_ctx->target_arch;
+    uint32 type = relocation->relocation_type;
+
+    if ((strcmp(relocation_group->section_name, ".text")
+         && strcmp(relocation_group->section_name, ".ltext"))
+        || !str_starts_with(relocation->symbol_name, AOT_FUNC_INTERNAL_PREFIX))
+        return false;
+    /* Windows AOT_COFF64_BIN_TYPE */
+    if (obj_data->target_info.bin_type == 6)
+        /* IMAGE_REL_AMD64_REL32 and IMAGE_REL_ARM64_BRANCH26 */
+        return (!strncmp(arch, "x86_64", 6) && type == 4)
+               || (!strncmp(arch, "aarch64", 7) && type == 3);
+    /* Windows AOT_COFF32_BIN_TYPE, IMAGE_REL_I386_REL32 */
+    return obj_data->target_info.bin_type == 4 && !strncmp(arch, "i386", 4)
+           && type == 20;
+}
