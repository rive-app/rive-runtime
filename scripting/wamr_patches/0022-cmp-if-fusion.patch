+/* Replaces the just-emitted i32 compare and the branch label after it with
+   fused_opcode reading the compare's operands, and consumes the compare's
+   result slot without emitting a pop. The caller pops its type. */
+static void
+wasm_loader_fuse_cmp_branch(WASMLoaderContext *loader_ctx, uint8 cmp_opcode,
+                            uint8 fused_opcode)
+{
+    uint32 opnd_bytes = cmp_opcode == WASM_OP_I32_EQZ ? 2 : 4;
+    int16 opnd[2] = { 0, 0 };
+
+    if (loader_ctx->p_code_compiled) {
+        /* the compare's source operands sit right before its result slot
+           and the branch label */
+        uint8 *opnd_end = loader_ctx->p_code_compiled - EMIT_LABEL_SIZE - 2;
+        bh_memcpy_s(opnd, (uint32)sizeof(opnd), opnd_end - opnd_bytes,
+                    opnd_bytes);
+    }
+    skip_label();
+    wasm_loader_emit_backspace(loader_ctx, 2 + opnd_bytes);
+    skip_label();
+    emit_label(fused_opcode);
+    emit_operand(loader_ctx, opnd[0]);
+    if (opnd_bytes == 4)
+        emit_operand(loader_ctx, opnd[1]);
+    /* mirrors wasm_loader_pop_frame_offset */
+    loader_ctx->frame_offset--;
+    if ((*(loader_ctx->frame_offset) > loader_ctx->start_dynamic_offset)
+        && (*(loader_ctx->frame_offset) < loader_ctx->max_dynamic_offset))
+        loader_ctx->dynamic_offset--;
+}
+
+/* An if is a branch to its else when the condition is false, so a compare
+   feeding it fuses into the inverted compare branch; eqz inverts to a plain
+   nonzero test */
+static uint8
+wasm_loader_inverted_cmp_branch(uint8 cmp_opcode)
+{
+    static const uint8 inverted[] = {
+        EXT_OP_BR_IF0,         EXT_OP_BR_IF_I32_NE,   EXT_OP_BR_IF_I32_EQ,
+        EXT_OP_BR_IF_I32_GE_S, EXT_OP_BR_IF_I32_GE_U, EXT_OP_BR_IF_I32_LE_S,
+        EXT_OP_BR_IF_I32_LE_U, EXT_OP_BR_IF_I32_GT_S, EXT_OP_BR_IF_I32_GT_U,
+        EXT_OP_BR_IF_I32_LT_S, EXT_OP_BR_IF_I32_LT_U,
+    };
+    return inverted[cmp_opcode - WASM_OP_I32_EQZ];
 }
