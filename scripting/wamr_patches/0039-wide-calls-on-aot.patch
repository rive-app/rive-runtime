From: rive
Subject: [PATCH 0039] stage calls wider than 64 cells in the caller's frame

wamrc staged native, call_indirect and extra result values through
exec_env's 64 cell argv_buf and refused any wider signature, so a script
closure taking 64 i32 or 32 f64 parameters never compiled ahead of time.
Wider calls now stage through a buffer in the calling function's entry
block. The runtime reads the argv it is handed, so runtimes without this
patch run these artifacts too. A call whose extra results land there drops
its tail marker, since LLVM assumes a tail callee never touches the
caller's frame.

--- a/core/iwasm/compilation/aot_emit_function.c
+++ b/core/iwasm/compilation/aot_emit_function.c
@@ -154,6 +154,39 @@ check_call_return(AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
     return true;
 }
 
+/* rive patch: argv_buf holds 64 cells, so wider calls stage in this frame,
+   which older runtimes read too since they use the argv they are handed */
+static LLVMValueRef
+get_argv_buf(AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
+             uint32 cell_num)
+{
+    LLVMBasicBlockRef block_curr, block_entry;
+    LLVMValueRef first_instr, argv_buf;
+    LLVMTypeRef argv_buf_type;
+
+    if (cell_num <= 64)
+        return func_ctx->argv_buf;
+
+    /* In the entry block, so a call inside a loop cannot grow the stack */
+    block_curr = LLVMGetInsertBlock(comp_ctx->builder);
+    block_entry = LLVMGetEntryBasicBlock(func_ctx->func);
+    if ((first_instr = LLVMGetFirstInstruction(block_entry)))
+        LLVMPositionBuilderBefore(comp_ctx->builder, first_instr);
+    else
+        LLVMPositionBuilderAtEnd(comp_ctx->builder, block_entry);
+
+    if (!(argv_buf_type = LLVMArrayType(I32_TYPE, cell_num))
+        || !(argv_buf = LLVMBuildAlloca(comp_ctx->builder, argv_buf_type,
+                                        "wide_argv_buf"))) {
+        aot_set_last_error("llvm build alloca failed.");
+        return NULL;
+    }
+    LLVMSetAlignment(argv_buf, 8);
+
+    LLVMPositionBuilderAtEnd(comp_ctx->builder, block_curr);
+    return argv_buf;
+}
