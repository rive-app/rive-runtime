@@ -3285,6 +3285,47 @@ wasm_runtime_rive_clear_interrupt(WASMExecEnv *exec_env)
                                  ~WASM_SUSPEND_FLAG_TERMINATE);
 }
 
+bool
+wasm_runtime_rive_interrupted(WASMExecEnv *exec_env)
+{
+    return (WASM_SUSPEND_FLAGS_GET(exec_env->suspend_flags)
+            & WASM_SUSPEND_FLAG_TERMINATE)
+           != 0;
+}
+
+WASMModuleInstanceCommon *
+wasm_runtime_instantiate_parallel_member(WASMModuleInstanceCommon *parent,
+                                         uint32 stack_size, char *error_buf,
+                                         uint32 error_buf_size)
+{
+    WASMModuleInstance *parent_inst = (WASMModuleInstance *)parent;
+
+#if WASM_ENABLE_SHARED_MEMORY != 0
+    if (parent_inst->memory_count == 1
+        && shared_memory_is_shared(parent_inst->memories[0]))
+        return wasm_runtime_instantiate_internal(
+            (WASMModuleCommon *)parent_inst->module, parent, NULL, stack_size,
+            0, 0, error_buf, error_buf_size);
+#endif
+    (void)parent_inst;
+    (void)stack_size;
+    set_error_buf(error_buf, error_buf_size,
+                  "parallel call members need one shared memory");
+    return NULL;
+}
+
+void
+wasm_runtime_copy_globals(WASMModuleInstanceCommon *dst,
+                          WASMModuleInstanceCommon *src)
+{
+    WASMModuleInstance *dst_inst = (WASMModuleInstance *)dst;
+    WASMModuleInstance *src_inst = (WASMModuleInstance *)src;
+
+    bh_assert(dst_inst->module == src_inst->module);
+    bh_memcpy_s(dst_inst->global_data, dst_inst->global_data_size,
+                src_inst->global_data, src_inst->global_data_size);
+}
