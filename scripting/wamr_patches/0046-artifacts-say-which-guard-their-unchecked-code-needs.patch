diff --git a/core/iwasm/compilation/aot_emit_memory.c b/core/iwasm/compilation/aot_emit_memory.c
index 0f42df5..2c80243 100644
--- a/core/iwasm/compilation/aot_emit_memory.c
+++ b/core/iwasm/compilation/aot_emit_memory.c
@@ -832,6 +832,25 @@ aot_check_memory_overflow(AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
         }
     }
 
+    /* rive patch: the runtime reserves only the guard past 4 GB, so an
+       unchecked access whose offset could reach beyond it checks its end */
+    if (!comp_ctx->enable_bound_check && is_target_64bit && !is_memory64
+        && (uint64)offset + bytes > comp_ctx->rive_hw_guard) {
+        LLVMValueRef reserve_bound =
+            I64_CONST(4 * (uint64)BH_GB + comp_ctx->rive_hw_guard - bytes);
+
+        CHECK_LLVM_CONST(reserve_bound);
+        BUILD_ICMP(LLVMIntUGT, offset1, reserve_bound, cmp, "cmp_reserve");
+        ADD_BASIC_BLOCK(check_succ, "check_reserve_succ");
+        LLVMMoveBasicBlockAfter(check_succ, block_curr);
+        if (!aot_emit_exception(comp_ctx, func_ctx,
+                                EXCE_OUT_OF_BOUNDS_MEMORY_ACCESS, true, cmp,
+                                check_succ)) {
+            goto fail;
+        }
+        SET_BUILD_POS(check_succ);
+    }
+
