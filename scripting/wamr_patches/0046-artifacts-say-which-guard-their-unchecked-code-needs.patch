From: rive
Subject: [PATCH 0046] artifacts say which guard their unchecked code needs

Code compiled without bounds checks relied on the runtime reserving 8 GB per
memory, the most a wasm32 index plus a 32 bit offset can reach. wamrc now
leaves unchecked only an access whose offset and size fit a guard past 4 GB,
64 KB unless --rive-hw-guard says otherwise, and checks the end of any other
access against that reservation, a compare with a constant. Every artifact
records whether its code checks bounds and, if not, the guard it needs; the
loader refuses an artifact that records neither, and a guard other than the
runtime's. The artifact now also decides whether its traps unwind through the
guard page, which the embedder used to set.

diff --git a/core/iwasm/aot/aot_loader.c b/core/iwasm/aot/aot_loader.c
index 78dde4a..822128d 100644
--- a/core/iwasm/aot/aot_loader.c
+++ b/core/iwasm/aot/aot_loader.c
@@ -519,6 +519,43 @@ check_feature_flags(char *error_buf, uint32 error_buf_size,
     return true;
 }
 
+/* rive patch: code that skips bounds checks is safe only over the
+   reservation it was compiled for */
+static bool
+check_rive_bounds(AOTModule *module, uint64 bounds, char *error_buf,
+                  uint32 error_buf_size)
+{
+    uint64 guard =
+        bounds & ~(RIVE_AOT_BOUNDS_KNOWN | RIVE_AOT_BOUNDS_UNCHECKED);
+
+    if (!(bounds & RIVE_AOT_BOUNDS_KNOWN)) {
+        set_error_buf(error_buf, error_buf_size,
+                      "artifact records nothing about its bounds; compile it "
+                      "again with a current wamrc");
+        return false;
+    }
+    if (!(bounds & RIVE_AOT_BOUNDS_UNCHECKED))
+        return true;
+#ifdef OS_ENABLE_HW_BOUND_CHECK
+    if (guard == WASM_RIVE_HW_GUARD_SIZE) {
+        module->rive_hw_bounds = true;
+        return true;
+    }
+    set_error_buf_v(error_buf, error_buf_size,
+                    "artifact skips bounds checks within a %" PRIu64
+                    " byte guard, this runtime reserves %u; compile it again "
+                    "with a current wamrc",
+                    guard, (uint32)WASM_RIVE_HW_GUARD_SIZE);
+#else
+    (void)module;
+    (void)guard;
+    set_error_buf(error_buf, error_buf_size,
+                  "artifact skips bounds checks, which this build cannot "
+                  "trap; compile it with --bounds-checks=1");
+#endif
+    return false;
+}
+
 #if WASM_ENABLE_GC != 0
 static WASMRefType *
 reftype_set_insert(HashMap *ref_type_set, const WASMRefType *ref_type,
@@ -550,7 +587,7 @@ load_target_info_section(const uint8 *buf, const uint8 *buf_end,
     read_uint32(p, p_end, target_info.e_version);
     read_uint32(p, p_end, target_info.e_flags);
     read_uint64(p, p_end, target_info.feature_flags);
-    read_uint64(p, p_end, target_info.reserved);
+    read_uint64(p, p_end, target_info.rive_bounds);
     read_byte_array(p, p_end, target_info.arch, sizeof(target_info.arch));
 
     if (target_info.arch[sizeof(target_info.arch) - 1] != '\0') {
@@ -620,6 +657,11 @@ load_target_info_section(const uint8 *buf, const uint8 *buf_end,
     module->feature_flags = target_info.feature_flags;
 #endif
 
+    if (!check_rive_bounds(module, target_info.rive_bounds, error_buf,
+                           error_buf_size)) {
+        return false;
+    }
+
     /* Finally, check feature flags */
     return check_feature_flags(error_buf, error_buf_size,
                                target_info.feature_flags);
diff --git a/core/iwasm/aot/aot_runtime.h b/core/iwasm/aot/aot_runtime.h
index ce6bf62..a94b5ce 100644
--- a/core/iwasm/aot/aot_runtime.h
+++ b/core/iwasm/aot/aot_runtime.h
@@ -36,6 +36,12 @@ extern "C" {
 #define WASM_FEATURE_FRAME_PER_FUNCTION (1 << 12)
 #define WASM_FEATURE_FRAME_NO_FUNC_IDX (1 << 13)
 
+/* rive: target info's rive_bounds says how the code bounds memory accesses;
+   artifacts from before it carry 0 there and are refused */
+#define RIVE_AOT_BOUNDS_KNOWN ((uint64)1 << 63)
+/* with the guard past 4 GB that unchecked accesses reach in the low bits */
+#define RIVE_AOT_BOUNDS_UNCHECKED ((uint64)1 << 62)
+
 typedef enum AOTSectionType {
     AOT_SECTION_TYPE_TARGET_INFO = 0,
     AOT_SECTION_TYPE_INIT_DATA = 1,
@@ -349,11 +355,8 @@ typedef struct AOTModule {
     /* Whether the underlying wasm binary buffer can be freed */
     bool is_binary_freeable;
 
-    /* rive patch: artifact compiled without sw bounds checks, so exceptions
-       unwind through the exce_check guard page; sw artifacts unwind by
-       checked returns and must never take that longjmp. Set by the embedder
-       via wasm_runtime_set_module_hw_bounds; the file format records
-       nothing. */
+    /* rive patch: the artifact says its code skips bounds checks, so its
+       memories reserve the guarded range and traps unwind through it */
     bool rive_hw_bounds;
 
     /* `.data` sections merged into one mmaped to reduce the tlb cache miss */
@@ -392,8 +395,8 @@ typedef struct AOTTargetInfo {
     uint32 e_flags;
     /* Specify wasm features supported */
     uint64 feature_flags;
-    /* Reserved */
-    uint64 reserved;
+    /* rive: RIVE_AOT_BOUNDS_* */
+    uint64 rive_bounds;
     /* Arch name */
     char arch[16];
 } AOTTargetInfo;
