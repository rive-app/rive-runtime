+#if defined(BH_PLATFORM_WINDOWS) \
+    && (defined(BUILD_TARGET_X86_64) || defined(BUILD_TARGET_AMD_64))
+/* rive patch: compiled code has no unwind info, so the SEH walk for a crash
+   in a native it called stopped at its frames, short of the unhandled
+   exception filter crash reporters set. Its frames now hand such a crash to
+   that filter, as the thread's start would. */
+static EXCEPTION_DISPOSITION
+aot_code_exception_handler(EXCEPTION_RECORD *record, ULONG64 frame,
+                           CONTEXT *context, void *dispatcher)
+{
+    EXCEPTION_POINTERS pointers = { record, context };
+
+    (void)frame;
+    (void)dispatcher;
+    if (record->ExceptionFlags & EXCEPTION_UNWIND)
+        return ExceptionContinueSearch;
+    switch (UnhandledExceptionFilter(&pointers)) {
+        case EXCEPTION_CONTINUE_EXECUTION:
+            return ExceptionContinueExecution;
+        case EXCEPTION_EXECUTE_HANDLER:
+            TerminateProcess(GetCurrentProcess(), record->ExceptionCode);
+            break;
+        default:
+            break;
+    }
+    return ExceptionContinueSearch;
+}
+
+/* Unwind info naming that handler, and a jump to it, below 4GB with the
+   code, as a function table reaches both by 32 bit addresses */
+static uint8 *aot_code_unwind_info = NULL;
+static INIT_ONCE aot_code_unwind_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK
+create_aot_code_unwind_info(PINIT_ONCE once, PVOID param, PVOID *context)
+{
+    uint32 page_size = os_getpagesize();
+    uint8 *page = os_mmap(NULL, page_size,
+                          MMAP_PROT_READ | MMAP_PROT_WRITE | MMAP_PROT_EXEC,
+                          MMAP_MAP_32BIT, os_get_invalid_handle());
+    uint64 handler = (uint64)(uintptr_t)aot_code_exception_handler;
+    uint32 thunk = (uint32)(uintptr_t)(page + 16);
+    DWORD old_protect;
+
+    (void)once;
+    (void)param;
+    (void)context;
+    if (!page)
+        return FALSE;
+    if ((uintptr_t)page + page_size > UINT32_MAX) {
+        os_munmap(page, page_size);
+        return FALSE;
+    }
+    /* Version 1 with a handler, no prologue or unwind codes */
+    page[0] = 1 | (UNW_FLAG_EHANDLER << 3);
+    bh_memcpy_s(page + 4, 4, &thunk, 4);
+    /* mov rax, handler; jmp rax */
+    page[16] = 0x48;
+    page[17] = 0xb8;
+    bh_memcpy_s(page + 18, 8, &handler, 8);
+    page[26] = 0xff;
+    page[27] = 0xe0;
+    VirtualProtect(page, page_size, PAGE_EXECUTE_READ, &old_protect);
+    aot_code_unwind_info = page;
+    return TRUE;
+}
+
+static void
+add_code_function_table(AOTModule *module)
+{
+    RUNTIME_FUNCTION *table;
+    uintptr_t code = (uintptr_t)module->code;
+
+    if (!code || code + module->code_size > UINT32_MAX
+        || !InitOnceExecuteOnce(&aot_code_unwind_once,
+                                create_aot_code_unwind_info, NULL, NULL)
+        || !(table = wasm_runtime_malloc(sizeof(RUNTIME_FUNCTION))))
+        return;
+    table->BeginAddress = (DWORD)code;
+    table->EndAddress = (DWORD)(code + module->code_size);
+    table->UnwindData = (DWORD)(uintptr_t)aot_code_unwind_info;
+    if (RtlAddFunctionTable(table, 1, 0))
+        module->rive_code_function_table = table;
+    else
+        wasm_runtime_free(table);
+}
+#endif
