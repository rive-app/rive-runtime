+
+static void
+invoke_native_call(void *data)
+{
+    InvokeNativeCall *call = data;
+    WASMExecEnv *exec_env = call->exec_env;
+
+#if WASM_ENABLE_QUICK_AOT_ENTRY != 0
+    /* Quick call if the quick aot entry is registered */
+    if (!call->signature && call->func_type->quick_aot_entry) {
+        void (*invoke_native)(void *func_ptr, void *exec_env, uint32 *argv,
+                              uint32 *argv_ret) =
+            call->func_type->quick_aot_entry;
+        exec_env->attachment = call->attachment;
+        invoke_native(call->func_ptr, exec_env, call->argv, call->argv_ret);
+        exec_env->attachment = NULL;
