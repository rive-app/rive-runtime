+bool
+aot_emits_strict_fp(const AOTCompContext *comp_ctx)
+{
+    const char *arch = comp_ctx->target_arch;
+    return strncmp(arch, "aarch64", 7) && strncmp(arch, "arm", 3)
+           && strncmp(arch, "thumb", 5) && strncmp(arch, "x86_64", 6)
+           && strncmp(arch, "i386", 4);
+}
+
+void
+aot_set_unlikely_branch(const AOTCompContext *comp_ctx, LLVMValueRef br,
+                        bool first_unlikely)
+{
+    LLVMContextRef ctx = comp_ctx->context;
+    LLVMTypeRef i32 = LLVMInt32TypeInContext(ctx);
+    LLVMMetadataRef ops[3] = {
+        LLVMMDStringInContext2(ctx, "branch_weights", 14),
+        LLVMValueAsMetadata(
+            LLVMConstInt(i32, first_unlikely ? 1 : 1048575, false)),
+        LLVMValueAsMetadata(
+            LLVMConstInt(i32, first_unlikely ? 1048575 : 1, false)),
+    };
+    LLVMSetMetadata(
+        br, LLVMGetMDKindIDInContext(ctx, "prof", 4),
+        LLVMMetadataAsValue(ctx, LLVMMDNodeInContext2(ctx, ops, 3)));
+}
+
