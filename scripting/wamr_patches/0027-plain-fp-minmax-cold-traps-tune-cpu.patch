From: rive
Subject: [PATCH 0027] plain fp ops, wasm min/max, cold traps, --tune-cpu

Wasm fixes round to nearest and raises no fp exceptions, which is LLVM's
default environment, so arm and x86 lower float arithmetic to plain IR ops
instead of constrained intrinsics (no strictfp then). f32/f64 min and max
lower to llvm.minimum/maximum, one fmin/fmax on AArch64. Trap and
exception edges carry unlikely branch weights and a cold call, so their
phi constants and spills stay off hot paths. --tune-cpu=<cpu> sets the
scheduling model on every function without raising the --cpu baseline.

--- a/core/iwasm/compilation/aot_emit_exception.c
+++ b/core/iwasm/compilation/aot_emit_exception.c
@@ -115,11 +115,19 @@
         /* Call the aot_set_exception_with_id() function */
         param_values[0] = func_ctx->aot_inst;
         param_values[1] = func_ctx->exception_id_phi;
-        if (!LLVMBuildCall2(comp_ctx->builder, func_type, func, param_values, 2,
-                            "")) {
+        LLVMValueRef exce_call;
+        if (!(exce_call = LLVMBuildCall2(comp_ctx->builder, func_type, func,
+                                         param_values, 2, ""))) {
             aot_set_last_error("llvm build call failed.");
             return false;
         }
+        /* rive: a cold trap path keeps spills and constant moves for its
+           phi out of the hot code */
+        LLVMAddCallSiteAttribute(
+            exce_call, LLVMAttributeFunctionIndex,
+            LLVMCreateEnumAttribute(comp_ctx->context,
+                                    LLVMGetEnumAttributeKindForName("cold", 4),
+                                    0));
 
         /* Create return IR */
         AOTFuncType *aot_func_type = func_ctx->aot_func->func_type;
@@ -172,12 +180,14 @@
     }
     else {
         /* Create condition br */
-        if (!LLVMBuildCondBr(comp_ctx->builder, cond_br_if,
-                             func_ctx->got_exception_block,
-                             cond_br_else_block)) {
+        LLVMValueRef br;
+        if (!(br = LLVMBuildCondBr(comp_ctx->builder, cond_br_if,
+                                   func_ctx->got_exception_block,
+                                   cond_br_else_block))) {
             aot_set_last_error("llvm build cond br failed.");
             return false;
         }
+        aot_set_unlikely_branch(comp_ctx, br, true);
         /* Start to translate the else block */
         LLVMPositionBuilderAtEnd(comp_ctx->builder, cond_br_else_block);
     }
