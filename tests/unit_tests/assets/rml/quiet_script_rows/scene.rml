        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="0:15"/>
    </Artboard>

    <!-- A row: Box, whose x follows the item's box, Probe, and Line, whose
         stroke Shift moves by the item's offset. Its machine does nothing but
         pass pointers on to Probe. -->
    <Artboard isComponent="true" defaultStateMachineId="0:60" viewModelId="0:50" x="400" width="300" height="60" styleId="0:35" name="Row" id="0:30">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Row Style" id="0:35"/>
        <Shape x="10" y="10" name="Box" id="0:31">
            <DataBindContext sourcePathIds="0:50-0:55" propertyKey="13"/>
            <Rectangle width="20" height="20" name="Rect" id="0:32"/>
            <Fill>
                <SolidColor colorValue="FF888888"/>
            </Fill>
        </Shape>
        <ScriptedDrawable scriptAssetId="0:80" name="Probe" id="0:33">
            <ScriptInputNumber name="level" id="0:34">
                <DataBindContext sourcePathIds="0:50-0:51" propertyKey="243"/>
