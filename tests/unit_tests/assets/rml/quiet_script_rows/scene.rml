        </ScriptedDrawable>
        <Shape x="200" y="10" name="Line" id="0:36">
            <Rectangle width="40" height="20" name="Line Rect" id="0:37"/>
            <Stroke thickness="2" name="Line Stroke" id="0:38">
                <SolidColor colorValue="FF444444"/>
                <ScriptedPathEffect scriptAssetId="0:81" name="Shift" id="0:39">
                    <ScriptInputNumber name="offset" id="0:90">
                        <DataBindContext sourcePathIds="0:50-0:56" propertyKey="243"/>
                    </ScriptInputNumber>
                </ScriptedPathEffect>
            </Stroke>
        </Shape>
        <StateMachine name="Row Machine" id="0:60">
            <StateMachineLayer name="Layer" id="0:61">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="0:62"/>
                </EntryState>
                <AnimationState x="100" animationId="0:65" id="0:62"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="0:65"/>
    </Artboard>
    <ComponentAsset artboardId="0:30" name="Row"/>

    <ScriptAsset file="probe.luau" name="probe" id="0:80"/>
