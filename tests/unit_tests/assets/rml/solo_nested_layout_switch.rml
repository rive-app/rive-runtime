            <Fill name="Fill"><SolidColor colorValue="FFB02020" name="Red"/></Fill>
        </LayoutComponent>
        <StateMachine name="A Machine" id="0:37">
            <StateMachineLayer name="Layer 1" id="0:38"><AnyState/><ExitState/><EntryState/></StateMachineLayer>
        </StateMachine>
    </Artboard>
    <Artboard isComponent="true" defaultStateMachineId="0:47" width="200" height="100" styleId="0:41" x="800" name="B" id="0:40">
