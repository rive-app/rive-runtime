            </TextStylePaint>
            <TextStyleGlobal artboardId="3:4" name="Plain" id="1:21">
                <ViewModelInstance viewModelId="3:2" exports="true" name="Plain Instance" id="1:22"/>
            </TextStyleGlobal>
            <!-- A and B: styleA (Stateful). C: styleB (Plain). D: unbound. -->
            <TextValueRun styleId="1:18" text="aaa " name="A" id="1:40">
                <DataBindContext sourcePathIds="1:14-1:30" propertyKey="272" id="1:41"/>
            </TextValueRun>
            <TextValueRun styleId="1:18" text="bbb " name="B" id="1:42">
                <DataBindContext sourcePathIds="1:14-1:30" propertyKey="272" id="1:43"/>
