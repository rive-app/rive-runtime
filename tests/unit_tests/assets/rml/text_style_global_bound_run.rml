<Rive version="1" kind="fragment">
    <!--
      Source markup for assets/text_style_global_bound_run.riv. Not an editor
      export: rebuild the .riv from this file with the CLI, from a directory
      holding this scene.rml, a rive.yaml naming it (main: "Main") and
