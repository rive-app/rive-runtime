      build/text_style_global_bound_run.riv into assets/.

          rive . --once
    -->
    <Artboard defaultStateMachineId="1:7" viewModelId="1:14" viewModelInstanceId="1:15" width="500" height="500" styleId="1:5" name="Main" id="1:2">
        <Text sizingValue="2" width="400" height="117" x="20" y="44" name="Runs" exportName="true" id="1:17">
            <TextStylePaint fontSize="20" fontAssetId="1:16" familyName="Inter" styleName="Regular" name="Local" id="1:18">
                <Fill fillRule="2" id="1:19">
                    <SolidColor colorValue="FFFFFFFF" id="1:20"/>
