            <TextValueRun styleId="1:18" text="ddd" name="D" id="1:46"/>
        </Text>
        <Fill fillRule="2" id="1:3">
            <SolidColor colorValue="FF282828" id="1:4"/>
        </Fill>
        <LayoutComponentStyle id="1:5"/>
        <StateMachine name="State Machine 1" id="1:7">
            <StateMachineLayer name="Layer 1" id="1:8">
                <AnyState x="400" id="1:9"/>
                <ExitState x="480" id="1:10"/>
                <EntryState id="1:11">
                    <StateTransition stateToId="1:12" id="1:13"/>
                </EntryState>
                <AnimationState animationId="1:6" x="160" id="1:12"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation name="Timeline 1" id="1:6"/>
    </Artboard>
    <!-- Red until pressed, then blue. A target-less down listener sets
         `pressed` on the style's own values. -->
    <Artboard defaultStateMachineId="2:23" viewModelId="2:2" viewModelInstanceId="2:3" isComponent="true" includeInExport="false" artboardKind="2" width="200" height="60" styleId="2:5" x="600" name="Stateful" id="2:4">
        <TextStylePaint fontSize="20" fontAssetId="1:16" familyName="Inter" styleName="Regular" id="2:6">
            <Fill fillRule="2" id="2:7">
                <SolidColor id="2:8"/>
            </Fill>
        </TextStylePaint>
        <LayoutComponentStyle id="2:5"/>
        <LinearAnimation name="idle" id="2:22">
            <KeyedObject objectId="2:8" id="2:61">
                <KeyedProperty propertyKey="37" id="2:62">
                    <KeyFrameColor value="FFB40000" interpolationType="1" id="2:63"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation name="pressed" id="2:33">
            <KeyedObject objectId="2:8" id="2:64">
                <KeyedProperty propertyKey="37" id="2:65">
                    <KeyFrameColor value="FF0000FF" interpolationType="1" id="2:66"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <StateMachine name="State Machine 1" id="2:23">
            <StateMachineLayer name="Layer 1" id="2:24">
                <AnyState x="358" y="29" id="2:25"/>
                <ExitState x="480" id="2:26"/>
                <EntryState id="2:27">
                    <StateTransition stateToId="2:28" id="2:29"/>
                </EntryState>
                <AnimationState animationId="2:22" x="160" id="2:28">
                    <StateTransition stateToId="2:34" id="2:35">
                        <TransitionViewModelCondition id="2:56">
                            <TransitionPropertyViewModelComparator id="2:57">
                                <BindablePropertyBoolean id="2:58">
                                    <DataBindContext sourcePathIds="2:2-2:90" propertyKey="634" id="2:59"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true" id="2:60"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState animationId="2:33" x="282" y="-91" id="2:34"/>
            </StateMachineLayer>
            <!-- No target: listens to the runs the style is drawn for. -->
            <StateMachineListener name="Press" id="2:91">
                <ListenerInputType listenerTypeValue="down"/>
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="true">
