<Rive version="1" kind="fragment">
    <!--
      Source markup for assets/virtualized_focus_rows.riv. README.md, next to
      this file, says how to rebuild it.

      What it is for: Tab through a virtualized list whose rows hold focus
      (see virtualized_focus_rows_test.cpp). Main shows 20 items of 200x50 in
      a 200x200 viewport, so four at a time, through a vertical scroll that
      virtualizes and has elastic physics, so scrolling to a position
      animates. Items 5 and 6 are Labels, whose artboard holds nothing
      focusable; the rest are Rows. A Row's Target takes focus, and the row's
      machine writes its item's `focused` on focus and on blur.

      Outer nests the same thing: six Groups of 200x100, two showing, each a
      virtualized scroll of six Rows of which two show. Its items are named
      G<group>I<item>.

      Grid is a grid of four 100 wide columns in a 250 wide viewport that
      scrolls down only, so its last column is never built. Its 24 Cells of
      100x50 each take focus.
    -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" width="200" height="200" styleId="0:5" name="Main" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <LayoutComponent clip="true" width="200" height="200" styleId="0:12" name="Viewport" id="0:13">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" flexDirectionValue="column" name="Viewport Style" id="0:12"/>
            <LayoutComponent clip="false" width="200" height="100" styleId="0:14" name="Content" id="0:15">
                <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="hug" flexDirectionValue="column" name="Content Style" id="0:14"/>
                <ArtboardComponentList name="Rows" id="0:16">
                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="800"/>
                </ArtboardComponentList>
                <ScrollConstraint directionValue="vertical" virtualize="true" physicsId="0:90" name="Scroll" id="0:17"/>
            </LayoutComponent>
        </LayoutComponent>
        <StateMachine name="Main Machine" id="0:7">
            <StateMachineLayer name="Layer" id="0:8">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="0:20"/>
                </EntryState>
                <AnimationState x="100" animationId="0:19" id="0:20"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="0:19"/>
    </Artboard>

    <ElasticScrollPhysics friction="8" speedMultiplier="1" elasticFactor="0.66" name="Physics" id="0:90"/>

    <!-- A focusable row. -->
    <Artboard isComponent="true" defaultStateMachineId="0:37" viewModelId="0:50" x="400" width="200" height="50" styleId="0:35" name="Row" id="0:30">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Row Style" id="0:35"/>
        <LayoutComponent width="200" height="50" styleId="0:32" name="Target" id="0:31">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Target Style" id="0:32"/>
            <FocusData name="Focus" id="0:33"/>
            <Fill name="Fill"><SolidColor colorValue="FF303030" name="Color"/></Fill>
        </LayoutComponent>
        <StateMachine name="Row Machine" id="0:37">
            <StateMachineListener targetId="0:31" name="Focus" id="0:44">
                <ListenerInputType listenerTypeValue="focus"/>
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="true">
                        <DataBindContext sourcePathIds="0:50-0:51" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
            </StateMachineListener>
            <StateMachineListener targetId="0:31" name="Blur" id="0:45">
                <ListenerInputType listenerTypeValue="blur"/>
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="false">
                        <DataBindContext sourcePathIds="0:50-0:51" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
            </StateMachineListener>
            <StateMachineLayer name="Layer" id="0:38">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="0:71"/>
                </EntryState>
                <AnimationState x="100" animationId="0:70" id="0:71"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="0:70"/>
    </Artboard>

    <!-- A row with nothing to focus. -->
    <Artboard isComponent="true" viewModelId="0:60" x="400" y="100" width="200" height="50" styleId="0:65" name="Label" id="0:64">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Label Style" id="0:65"/>
    </Artboard>


    <!-- Lists in a list: each Group scrolls its own Rows. -->
    <Artboard defaultStateMachineId="1:7" viewModelId="1:40" x="0" y="400" width="200" height="200" styleId="1:5" name="Outer" id="1:2">
        <LayoutComponentStyle name="Outer Style" id="1:5"/>
        <LayoutComponent clip="true" width="200" height="200" styleId="1:12" name="Viewport" id="1:13">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" flexDirectionValue="column" name="Viewport Style" id="1:12"/>
            <LayoutComponent clip="false" width="200" height="100" styleId="1:14" name="Content" id="1:15">
                <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="hug" flexDirectionValue="column" name="Content Style" id="1:14"/>
                <ArtboardComponentList name="Groups" id="1:16">
                    <DataBindContext sourcePathIds="1:40-1:42" propertyKey="800"/>
                </ArtboardComponentList>
                <ScrollConstraint directionValue="vertical" virtualize="true" physicsId="0:90" name="Scroll" id="1:17"/>
            </LayoutComponent>
        </LayoutComponent>
        <StateMachine name="Machine" id="1:7">
            <StateMachineLayer name="Layer" id="1:8">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="1:20"/>
                </EntryState>
                <AnimationState x="100" animationId="1:19" id="1:20"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="1:19"/>
    </Artboard>

    <Artboard isComponent="true" defaultStateMachineId="1:37" viewModelId="1:50" x="400" y="400" width="200" height="100" styleId="1:35" name="Group" id="1:30">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Group Style" id="1:35"/>
        <LayoutComponent clip="true" width="200" height="100" styleId="1:32" name="Viewport" id="1:31">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" flexDirectionValue="column" name="Viewport Style" id="1:32"/>
            <LayoutComponent clip="false" width="200" height="100" styleId="1:33" name="Content" id="1:34">
                <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="hug" flexDirectionValue="column" name="Content Style" id="1:33"/>
                <ArtboardComponentList name="Inner" id="1:36">
                    <DataBindContext sourcePathIds="1:50-1:51" propertyKey="800"/>
                </ArtboardComponentList>
                <ScrollConstraint directionValue="vertical" virtualize="true" physicsId="0:90" name="Scroll" id="1:38"/>
            </LayoutComponent>
        </LayoutComponent>
        <StateMachine name="Machine" id="1:37">
            <StateMachineLayer name="Layer" id="1:39">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="1:71"/>
                </EntryState>
                <AnimationState x="100" animationId="1:70" id="1:71"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="1:70"/>
    </Artboard>

    <!-- A grid that scrolls down only, wider than its viewport. -->
    <Artboard defaultStateMachineId="2:7" viewModelId="2:40" x="0" y="800" width="250" height="200" styleId="2:5" name="Grid" id="2:2">
        <LayoutComponentStyle name="Grid Artboard Style" id="2:5"/>
        <LayoutComponent clip="true" width="250" height="200" styleId="2:12" name="Viewport" id="2:13">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Viewport Style" id="2:12"/>
            <LayoutComponent clip="false" styleId="2:14" name="Content" id="2:15">
                <LayoutComponentStyle layoutTypeValue="grid" layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Content Style" id="2:14"/>
                <GridTrack collection="template-columns" trackType="points" trackValue="100" name="C0"/>
                <GridTrack collection="template-columns" trackType="points" trackValue="100" name="C1"/>
                <GridTrack collection="template-columns" trackType="points" trackValue="100" name="C2"/>
                <GridTrack collection="template-columns" trackType="points" trackValue="100" name="C3"/>
                <GridTrack collection="auto-rows" trackType="points" trackValue="50" name="Row"/>
                <ScrollConstraint directionValue="vertical" virtualize="true" physicsId="0:90" name="Scroll" id="2:17"/>
                <ArtboardComponentList name="Cells" id="2:16">
                    <DataBindContext sourcePathIds="2:40-2:42" propertyKey="800"/>
                </ArtboardComponentList>
            </LayoutComponent>
        </LayoutComponent>
        <StateMachine name="Machine" id="2:7">
            <StateMachineLayer name="Layer" id="2:8">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="2:20"/>
                </EntryState>
                <AnimationState x="100" animationId="2:19" id="2:20"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="2:19"/>
    </Artboard>

    <Artboard isComponent="true" defaultStateMachineId="2:37" viewModelId="2:50" x="400" y="800" width="100" height="50" styleId="2:35" name="Cell" id="2:30">
