            <Shape x="150" y="50" name="Second" id="0:512">
                <Rectangle width="20" height="20" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFE05757" name="C"/></Fill>
            </Shape>
        </Solo>
        <LayoutComponent width="40" height="40" styleId="0:531" name="Panel" id="0:530">
