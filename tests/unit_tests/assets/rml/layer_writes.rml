        </LinearAnimation>
        <LinearAnimation loopValue="loop" duration="45" name="SlideB" id="0:221">
            <KeyedObject objectId="0:210">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" interpolationType="linear"/>
                    <KeyFrameDouble value="120" interpolationType="linear" frame="45"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="10" name="Low" id="0:222">
            <KeyedObject objectId="0:211">
                <KeyedProperty propertyKey="14"><KeyFrameDouble value="0"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="10" name="High" id="0:223">
            <KeyedObject objectId="0:211">
                <KeyedProperty propertyKey="14"><KeyFrameDouble value="50"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- AtEnd: when a later layer's transition finishes mixing, its action
         sets a view model number bound to the x an earlier layer wrote. -->
    <Artboard defaultStateMachineId="0:301" viewModelId="0:340" width="200" height="200" name="AtEnd" id="0:300">
        <Shape x="0" y="50" name="Box" id="0:310">
            <DataBindContext sourcePathIds="0:340-0:341" propertyKey="13"/>
            <Rectangle width="20" height="20" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF57A5E0" name="Color"/></Fill>
        </Shape>
        <StateMachine name="Machine" id="0:301">
            <StateMachineLayer name="A" id="0:302">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:303"/></EntryState>
                <AnimationState x="200" animationId="0:320" id="0:303"/>
            </StateMachineLayer>
            <StateMachineLayer name="B" id="0:304">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:305"/></EntryState>
                <AnimationState x="200" animationId="0:321" id="0:305">
                    <StateTransition stateToId="0:306" duration="100">
                        <ListenerViewModelChange flags="1">
                            <BindablePropertyNumber propertyValue="42">
                                <DataBindContext sourcePathIds="0:340-0:341" propertyKey="636" direction="true"/>
                            </BindablePropertyNumber>
                        </ListenerViewModelChange>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" animationId="0:322" id="0:306">
                    <StateTransition stateToId="0:305" duration="100"
                                     enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation loopValue="loop" duration="60" name="SlideA" id="0:320">
            <KeyedObject objectId="0:310">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" interpolationType="linear"/>
                    <KeyFrameDouble value="100" interpolationType="linear" frame="60"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="12" name="HoldB" id="0:321">
            <KeyedObject objectId="0:310">
                <KeyedProperty propertyKey="13"><KeyFrameDouble value="30"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="12" name="HoldC" id="0:322">
            <KeyedObject objectId="0:310">
                <KeyedProperty propertyKey="13"><KeyFrameDouble value="70"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- Pill: a Base layer rests the pill's height at 0 and a Selected layer
         holds it at 40, as discord_clone's server icons do. Both apply every
         frame; only the last one shows. -->
    <Artboard defaultStateMachineId="0:401" styleId="0:402" width="200" height="200" name="Pill" id="0:400">
        <LayoutComponentStyle name="Pill Artboard Style" id="0:402"/>
        <LayoutComponent width="8" height="0" styleId="0:411" name="Pill" id="0:410">
            <LayoutComponentStyle name="Pill Style" id="0:411"/>
