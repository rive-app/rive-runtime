    <!-- BoundFlag: a Base layer keys the panel's width scale type to fill and
         a Fixed layer keys it back to fixed, so each frame's scale type
         change sets intrinsicallySizedValue from the final types. A view
         model bool bound to intrinsicallySizedValue sets it too. Both loop,
         so neither layer rests on a finished pose. -->
    <Artboard defaultStateMachineId="0:901" viewModelId="0:940" styleId="0:902" width="200" height="200" name="BoundFlag" id="0:900">
        <LayoutComponentStyle name="BoundFlag Artboard Style" id="0:902"/>
        <LayoutComponent width="40" height="40" styleId="0:911" name="Panel" id="0:910">
            <LayoutComponentStyle name="Panel Style" id="0:911">
