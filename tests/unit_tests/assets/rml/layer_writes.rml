            <KeyedObject objectId="0:911">
                <KeyedProperty propertyKey="655"><KeyFrameUint value="0"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <ViewModel defaultInstanceId="0:942" name="Flags" id="0:940">
