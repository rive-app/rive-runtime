                </AnimationState>
                <AnimationState x="400" animationId="0:823" id="0:809">
                    <StateTransition stateToId="0:808" duration="500" enableExitTime="true" exitTime="1000"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="10" name="Rtl" id="0:820">
            <KeyedObject objectId="0:811">
                <KeyedProperty propertyKey="599"><KeyFrameUint value="2"/></KeyedProperty>
