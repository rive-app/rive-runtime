    <!-- ScaleTypes: a Base layer keys the panel's width scale type to fill and
         a Toggle layer flips it between fixed and hug; a Flag layer keys
         intrinsicallySizedValue, which a scale type change also sets. -->
    <Artboard defaultStateMachineId="0:701" styleId="0:702" width="200" height="200" name="ScaleTypes" id="0:700">
        <LayoutComponentStyle name="ScaleTypes Artboard Style" id="0:702"/>
        <LayoutComponent width="40" height="40" styleId="0:711" name="Panel" id="0:710">
            <LayoutComponentStyle name="Panel Style" id="0:711"/>
