    <!-- Direction: the cell inherits the artboard's layout animation. Two
         layers key the cell's direction to rtl and ltr, which clears what it
         inherited; a Grow layer then mixes the cell's width between states. -->
    <Artboard defaultStateMachineId="0:801" styleId="0:802" width="200" height="200" name="Direction" id="0:800">
        <LayoutComponentStyle animationStyleType="custom" interpolationType="linear" interpolationTime="1" name="Direction Artboard Style" id="0:802"/>
