                <KeyedProperty propertyKey="8"><KeyFrameDouble value="40"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- Discrete: a Base layer shows the Solo's first child and keeps a
         layout displayed; an Over layer shows the second child and hides the
         layout. Both apply every frame; only the last one shows. -->
    <Artboard defaultStateMachineId="0:501" styleId="0:502" width="200" height="200" name="Discrete" id="0:500">
        <LayoutComponentStyle name="Discrete Artboard Style" id="0:502"/>
        <Solo activeComponentId="0:511" name="Icons" id="0:510">
