<!--
  Source markup for assets/layer_writes.riv, which the rive CLI built from
  it (`rive . --once`, 1.8.0), kept alongside so the scene is readable
  without opening the binary. Each artboard has a property that two layers
  key (see layer_accumulator_test.cpp):
  - Blend: a later layer's blend state mixes from two earlier layers' x.
  - Reads: a third layer's transitions compare the x two layers wrote.
  - AtEnd: a transition's end action sets a view model number bound to x.
  - Pill: two layers hold a layout's height at different values.
  - Discrete: two layers show different Solo children and display values.
  Four more have a property two layers key alongside one whose writes
  depend on it, so none of them may wait for a flush:
  - Alias: a third layer keys the same x through its xArtboard key.
  - ScaleTypes: a third layer keys the intrinsicallySizedValue a scale type
    change sets.
  - BoundFlag: a view model bool is bound to the intrinsicallySizedValue a
    scale type change sets.
  - Direction: a third layer mixes a width whose mix reads the layout
    animation a direction change clears.
-->
<Rive version="1" kind="fragment">
    <!-- Blend: a later layer's blend state mixes from what two earlier
         layers wrote to the same x this frame. -->
    <Artboard defaultStateMachineId="0:101" width="200" height="200" name="Blend" id="0:100">
        <Shape x="0" y="100" name="Box" id="0:110">
            <Rectangle width="20" height="20" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF57A5E0" name="Color"/></Fill>
        </Shape>
        <StateMachine name="Machine" id="0:101">
            <StateMachineNumber name="mix" value="50" id="0:102"/>
            <StateMachineLayer name="Base" id="0:103">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:104"/></EntryState>
                <AnimationState x="200" animationId="0:120" id="0:104"/>
            </StateMachineLayer>
            <StateMachineLayer name="Drift" id="0:107">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:108"/></EntryState>
                <AnimationState x="200" animationId="0:123" id="0:108"/>
            </StateMachineLayer>
            <StateMachineLayer name="Blend" id="0:105">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:106"/></EntryState>
                <BlendState1DInput x="200" inputId="0:102" id="0:106">
                    <BlendAnimation1D animationId="0:121" value="0"/>
                    <BlendAnimation1D animationId="0:122" value="100"/>
                </BlendState1DInput>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation loopValue="loop" duration="60" name="Slide" id="0:120">
            <KeyedObject objectId="0:110">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" interpolationType="linear"/>
                    <KeyFrameDouble value="100" interpolationType="linear" frame="60"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation loopValue="loop" duration="45" name="Drift" id="0:123">
            <KeyedObject objectId="0:110">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="10" interpolationType="linear"/>
                    <KeyFrameDouble value="60" interpolationType="linear" frame="45"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="10" name="Left" id="0:121">
            <KeyedObject objectId="0:110">
                <KeyedProperty propertyKey="13"><KeyFrameDouble value="20"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
        <LinearAnimation duration="10" name="Right" id="0:122">
            <KeyedObject objectId="0:110">
                <KeyedProperty propertyKey="13"><KeyFrameDouble value="180"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- Reads: a third layer's transitions compare the x two earlier layers
         wrote this frame. -->
    <Artboard defaultStateMachineId="0:201" width="200" height="200" name="Reads" id="0:200">
        <Shape x="0" y="50" name="Box" id="0:210">
            <Rectangle width="20" height="20" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF57A5E0" name="Color"/></Fill>
        </Shape>
        <Shape x="100" y="0" name="Marker" id="0:211">
            <Rectangle width="20" height="20" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFE05757" name="Color"/></Fill>
        </Shape>
        <StateMachine name="Machine" id="0:201">
            <StateMachineLayer name="A" id="0:202">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:203"/></EntryState>
                <AnimationState x="200" animationId="0:220" id="0:203"/>
            </StateMachineLayer>
            <StateMachineLayer name="B" id="0:204">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:205"/></EntryState>
                <AnimationState x="200" animationId="0:221" id="0:205"/>
            </StateMachineLayer>
            <StateMachineLayer name="Watch" id="0:206">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:207"/></EntryState>
                <AnimationState x="200" animationId="0:222" id="0:207">
                    <StateTransition stateToId="0:208">
                        <TransitionViewModelCondition opValue="greaterThan">
                            <TransitionPropertyComponentComparator objectId="0:210" propertyKey="13"/>
                            <TransitionValueNumberComparator value="60"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="400" animationId="0:223" id="0:208">
                    <StateTransition stateToId="0:207">
                        <TransitionViewModelCondition opValue="lessThanOrEqual">
                            <TransitionPropertyComponentComparator objectId="0:210" propertyKey="13"/>
                            <TransitionValueNumberComparator value="60"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation loopValue="loop" duration="60" name="SlideA" id="0:220">
            <KeyedObject objectId="0:210">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="0" interpolationType="linear"/>
                    <KeyFrameDouble value="100" interpolationType="linear" frame="60"/>
