        <StateMachine name="Field Machine" id="0:160">
            <StateMachineBool name="fieldUp" id="0:170"/>
            <StateMachineBool name="fieldEnter" id="0:171"/>
            <StateMachineBool name="fieldHovered" id="0:172"/>
            <StateMachineBool name="fieldReleased" id="0:173"/>
            <StateMachineListener targetId="0:130" name="Focus Listener" id="0:180">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard"/>
                <ListenerInputTypeText listenerTypeValue="textInput"/>
            </StateMachineListener>
