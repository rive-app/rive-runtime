<Rive version="1" kind="fragment">
    <!--
      Source markup for assets/capture_listeners.riv. Not an editor export:
      rebuild the .riv from this file with the CLI, from a directory holding
      this scene.rml, a rive.yaml naming it and label_font.ttf (copied from
      packages/rive-cli/assets), then copy build/capture_listeners.riv into
      assets/.

          rive . --unsigned-riv

      Every listener here is in the normal phase. The tests flip the ones
      they need to the capture phase (StateMachineListener::phaseValue)
      before building a state machine instance, which reads the phase once
      when it registers its listeners.

      "Field" is the shape of the bundled text input library component: a
      Viewport layout whose down listener focuses the input, and a TextInput
      whose FocusData carries a match-any keyboard + text listener that opts
      it into keys. Field's machine also has a second match-any listener on
      the input, a filtered Enter listener, an Up listener, and enter/exit/up
      listeners on the Viewport, each setting a bool so a test can see it
      ran.

      "Host" stacks two slots in a column, each a fixed layout with a
      non-focusable FocusData around a nested Field, so each field's focus
      node sits under its slot's. Each slot has Up / Down keyboard listeners
      that traverse focus previous / next, a down listener and a move
      listener. Slot A also has a drag listener, and Slot B an Enter listener
      that fires on the key's release only and a secondary-button down
      listener. "Overlay" is an absolutely positioned, opaque layout
      with a down listener of its own, covering the right half of Slot B.
      It is Host's first child because siblings draw first-on-top.

      label_font covers digits and uppercase only, so text stays uppercase.

      Layout, in Host's space: the column has 20pt padding and a 20pt gap.
          Slot A    x 20..240, y 20..68    Field A fills it
          Slot B    x 20..240, y 88..136   Field B fills it
          Overlay   x 130..240, y 88..136  over Slot B's right half
    -->
    <Artboard clip="true" width="300" height="200" styleId="0:2" defaultStateMachineId="0:60" name="Host" id="0:1">
        <LayoutComponentStyle flexDirectionValue="column" paddingLeft="20" paddingTop="20" paddingRight="20" paddingBottom="20" gapVertical="20" name="Host Style" id="0:2"/>
        <LayoutComponent isTargetOpaque="true" width="110" height="48" styleId="0:31" name="Overlay" id="0:30">
            <LayoutComponentStyle positionTypeValue="absolute" positionLeft="130" positionTop="88" positionLeftUnitsValue="points" positionTopUnitsValue="points" layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Overlay Style" id="0:31"/>
            <Fill name="Overlay Fill"><SolidColor colorValue="80FFAC33"/></Fill>
        </LayoutComponent>
        <LayoutComponent width="220" height="48" styleId="0:11" name="Slot A" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Slot A Style" id="0:11"/>
            <FocusData canFocus="false" name="Slot A Focus" id="0:12"/>
            <NestedArtboard artboardId="0:100" name="Field A" id="0:13">
                <NestedStateMachine animationId="0:160" name="Field A Machine"/>
            </NestedArtboard>
            <Fill name="Slot A Fill"><SolidColor colorValue="FF263445"/></Fill>
        </LayoutComponent>
        <LayoutComponent width="220" height="48" styleId="0:21" name="Slot B" id="0:20">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Slot B Style" id="0:21"/>
            <FocusData canFocus="false" name="Slot B Focus" id="0:22"/>
            <NestedArtboard artboardId="0:100" name="Field B" id="0:23">
                <NestedStateMachine animationId="0:160" name="Field B Machine"/>
            </NestedArtboard>
            <Fill name="Slot B Fill"><SolidColor colorValue="FF263445"/></Fill>
        </LayoutComponent>
        <StateMachine name="Host Machine" id="0:60">
            <StateMachineBool name="slotAPressed" id="0:70"/>
            <StateMachineBool name="slotBPressed" id="0:71"/>
            <StateMachineBool name="slotAMoved" id="0:72"/>
            <StateMachineBool name="slotBMoved" id="0:73"/>
            <StateMachineBool name="slotBEnterReleased" id="0:74"/>
            <StateMachineBool name="overlayPressed" id="0:75"/>
            <StateMachineBool name="slotADragged" id="0:76"/>
            <StateMachineBool name="slotBSecondaryPressed" id="0:77"/>
            <StateMachineListener targetId="0:10" name="Slot A Up" id="0:80">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard"><KeyboardInput keyType="up" keyPhase="1"/></ListenerInputTypeKeyboard>
                <FocusActionTraversal traversalKind="previous"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:10" name="Slot A Down" id="0:81">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard"><KeyboardInput keyType="down" keyPhase="1"/></ListenerInputTypeKeyboard>
                <FocusActionTraversal traversalKind="next"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:20" name="Slot B Up" id="0:82">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard"><KeyboardInput keyType="up" keyPhase="1"/></ListenerInputTypeKeyboard>
                <FocusActionTraversal traversalKind="previous"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:20" name="Slot B Down" id="0:83">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard"><KeyboardInput keyType="down" keyPhase="1"/></ListenerInputTypeKeyboard>
                <FocusActionTraversal traversalKind="next"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:20" name="Slot B Enter Release" id="0:84">
                <ListenerInputTypeKeyboard listenerTypeValue="keyboard"><KeyboardInput keyType="enter" keyPhase="4"/></ListenerInputTypeKeyboard>
                <ListenerBoolChange value="true" inputId="0:74"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:10" name="Slot A Press" id="0:85">
                <ListenerInputType listenerTypeValue="down"/>
                <ListenerBoolChange value="true" inputId="0:70"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:20" name="Slot B Press" id="0:86">
                <ListenerInputType listenerTypeValue="down"/>
                <ListenerBoolChange value="true" inputId="0:71"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:10" name="Slot A Move" id="0:87">
                <ListenerInputType listenerTypeValue="move"/>
                <ListenerBoolChange value="true" inputId="0:72"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:20" name="Slot B Move" id="0:88">
                <ListenerInputType listenerTypeValue="move"/>
                <ListenerBoolChange value="true" inputId="0:73"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:30" name="Overlay Press" id="0:89">
                <ListenerInputType listenerTypeValue="down"/>
                <ListenerBoolChange value="true" inputId="0:75"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:10" name="Slot A Drag" id="0:91">
                <ListenerInputType listenerTypeValue="drag"/>
                <ListenerBoolChange value="true" inputId="0:76"/>
            </StateMachineListener>
            <StateMachineListener targetId="0:20" name="Slot B Secondary Press" id="0:92">
                <ListenerInputTypePointerButton listenerTypeValue="down" pointerButtonValue="secondary"/>
                <ListenerBoolChange value="true" inputId="0:77"/>
            </StateMachineListener>
            <StateMachineLayer name="Layer 1">
                <AnyState/>
                <ExitState/>
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <Artboard isComponent="true" clip="true" width="220" height="48" x="400" styleId="0:102" defaultStateMachineId="0:160" name="Field" id="0:100">
        <LayoutComponentStyle name="Field Style" id="0:102"/>
        <LayoutComponent clip="true" width="220" height="48" styleId="0:111" name="Viewport" id="0:110">
            <LayoutComponentStyle layoutAlignmentType="centerLeft" paddingLeft="10" layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Viewport Style" id="0:111"/>
            <LayoutComponent clip="false" styleId="0:121" name="Text Container" id="0:120">
                <LayoutComponentStyle intrinsicallySizedValue="true" layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="Container Style" id="0:121"/>
                <TextInput text="AB" multiline="false" name="Input" id="0:130">
