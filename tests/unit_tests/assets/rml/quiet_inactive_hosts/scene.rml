    </ViewModel>

    <ViewModel defaultInstanceId="0:43" name="Root" id="0:40">
        <ViewModelPropertyList name="items" id="0:42"/>
        <ViewModelPropertyList name="paintItems" id="0:45"/>
        <ViewModelPropertyList name="buzzItems" id="0:230"/>
