<Rive version="1" kind="fragment">
    <!--
      Source markup for assets/virtualized_row_hover_exit.riv. README.md, next
      to this file, says how to rebuild it.

      What it is for: a hovered list row that stops showing gets its pointer
      exit (see virtualized_row_hover_exit_test.cpp). Main shows the same kind
      of row in two scrolling lists: Virtual Rows, whose scroll virtualizes,
      and Plain Rows, whose scroll doesn't. Each Row sets its item's hover
      while the pointer is over its Hit shape, and hosts a Badge that sets
      the item's badgeHover while the pointer is over its Dot. Leaving Hit
      also fires the global Signals.rowLeft, which takes Main's machine from
      idle to left, and the Row Left event, on which the row's machine sets
      the item's leftEvent. Leaving Dot fires Badge Left, on which the row's
      machine sets badgeLeftEvent. The badge's machine sets badgeSawLeft
      once leftEvent changes. A press on Hit, and one on Dot, is taken
      by a capture listener (which sets pressed), claiming the pointer from
      the normal listeners there until its release.
    -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" width="300" height="300" styleId="0:5" name="Main" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <LayoutComponent width="300" height="300" styleId="0:11" name="Lists" id="0:10">
            <LayoutComponentStyle flexDirectionValue="row" name="Lists Style" id="0:11"/>
            <LayoutComponent clip="true" width="150" height="300" styleId="0:12" name="Virtual Viewport" id="0:13">
                <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" flexDirectionValue="column" name="Virtual Viewport Style" id="0:12"/>
                <LayoutComponent clip="false" width="150" height="100" styleId="0:14" name="Virtual Content" id="0:15">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="hug" flexDirectionValue="column" name="Virtual Content Style" id="0:14"/>
                    <ArtboardComponentList name="Virtual Rows" id="0:16">
                        <DataBindContext sourcePathIds="0:40-0:42" propertyKey="800"/>
                    </ArtboardComponentList>
                    <ScrollConstraint directionValue="vertical" virtualize="true" name="Virtual Scroll" id="0:17"/>
                </LayoutComponent>
            </LayoutComponent>
            <LayoutComponent clip="true" width="150" height="300" styleId="0:22" name="Plain Viewport" id="0:23">
                <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" flexDirectionValue="column" name="Plain Viewport Style" id="0:22"/>
                <LayoutComponent clip="false" width="150" height="100" styleId="0:24" name="Plain Content" id="0:25">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="hug" flexDirectionValue="column" name="Plain Content Style" id="0:24"/>
                    <ArtboardComponentList name="Plain Rows" id="0:26">
                        <DataBindContext sourcePathIds="0:40-0:46" propertyKey="800"/>
                    </ArtboardComponentList>
                    <ScrollConstraint directionValue="vertical" virtualize="false" name="Plain Scroll" id="0:27"/>
                </LayoutComponent>
            </LayoutComponent>
        </LayoutComponent>
        <StateMachine name="Main Machine" id="0:7">
            <StateMachineLayer name="Layer" id="0:8">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="0:20"/>
                </EntryState>
                <AnimationState x="100" animationId="0:19" id="0:20">
                    <StateTransition stateToId="0:21">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:80-0:81" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="200" animationId="0:18" id="0:21"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="0:19"/>
        <LinearAnimation duration="1" name="left" id="0:18"/>
    </Artboard>

    <!-- A row: Hit covers it, and Badge sits over its right end. -->
    <Artboard isComponent="true" defaultStateMachineId="0:37" viewModelId="0:50" x="400" width="150" height="60" styleId="0:35" name="Row" id="0:30">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Row Style" id="0:35"/>
        <NestedArtboard artboardId="0:60" x="100" y="10" name="Badge" id="0:32">
            <NestedStateMachine animationId="0:67" name="Badge Machine" id="0:33"/>
        </NestedArtboard>
        <Shape x="75" y="30" name="Hit" id="0:31">
            <Rectangle width="150" height="60" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF303030" name="Color"/></Fill>
        </Shape>
        <Event name="Row Left" id="0:47"/>
        <StateMachine name="Row Machine" id="0:37">
            <StateMachineListenerSingle targetId="0:31" listenerTypeValue="enter" name="Hover in" id="0:44">
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="true">
                        <DataBindContext sourcePathIds="0:50-0:51" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:31" listenerTypeValue="exit" name="Hover out" id="0:45">
                <ListenerViewModelChange>
                    <BindablePropertyBoolean>
                        <DataBindContext sourcePathIds="0:50-0:51" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
                <ListenerViewModelChange>
                    <BindablePropertyTrigger propertyValue="1">
                        <DataBindContext sourcePathIds="0:80-0:81" propertyKey="686" direction="true"/>
                    </BindablePropertyTrigger>
                </ListenerViewModelChange>
                <ListenerFireEvent eventId="0:47"/>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:30" listenerTypeValue="event" eventId="0:47" name="On row left" id="0:48">
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="true">
                        <DataBindContext sourcePathIds="0:50-0:53" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:32" listenerTypeValue="event" eventId="0:76" name="On badge left" id="0:49">
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="true">
                        <DataBindContext sourcePathIds="0:50-0:54" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:31" listenerTypeValue="down" phaseValue="capture" name="Claim press" id="0:39">
                <ListenerViewModelChange>
                    <BindablePropertyBoolean propertyValue="true">
                        <DataBindContext sourcePathIds="0:50-0:55" propertyKey="634" direction="true"/>
                    </BindablePropertyBoolean>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>
            <StateMachineLayer name="Layer" id="0:36">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="0:41"/>
                </EntryState>
                <AnimationState x="100" animationId="0:34" id="0:41"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="Rest" id="0:34"/>
    </Artboard>
    <ComponentAsset artboardId="0:30" name="Row"/>

    <Artboard isComponent="true" defaultStateMachineId="0:67" viewModelId="0:50" x="600" width="40" height="40" styleId="0:65" name="Badge" id="0:60">
        <LayoutComponentStyle name="Badge Style" id="0:65"/>
        <Shape x="20" y="20" name="Dot" id="0:61">
