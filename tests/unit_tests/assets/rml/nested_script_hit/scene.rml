<Rive version="1" kind="fragment">
<!-- Game is a 200 x 200 artboard whose script node claims every press, move
     and release, and counts each event (and each exit) on the root view
     model. Host nests it in a clipping 200 x 200 layout at (50,50), beside a
     grey Button (450..550, 100..200) whose listeners set over, pressed and
     released. Overflow nests it at (50,50) in a clipping 150 x 250 layout, so
     part of Game is clipped away and part of the clip has no Game under it.
     LayoutGame, LayoutHost and LayoutOverflow are the same with the script
     as a scripted layout that fills its artboard. SmallLayoutGame's layout
     is a 100 x 100 box at (50,50); SmallLayoutHost nests it as Host does.
     CoverHost and CoverLayoutHost add an opaque Cover (200..300, 100..200)
     drawn above the slot, whose enter sets covered. HoverGame's script hears
     moves without claiming them and has no press handler; HoverHost nests
     it as Host does. DeepCoverHost is CoverHost with MidGame in its slot,
     a 200 x 200 artboard that nests Game. ClipGame's script counts presses
     without claiming them, under a full-size Target whose down sets hit.
     ScaledMountHost, RotatedMountHost and FitHost clip it to (50,50)..
     (200,200), scaled 2x by its mount, turned 90 degrees, or fit 2x. -->
    <ViewModel name="H" id="0:40">
        <ViewModelPropertyBoolean name="over" id="0:41"/>
        <ViewModelPropertyBoolean name="pressed" id="0:42"/>
        <ViewModelPropertyBoolean name="released" id="0:43"/>
        <ViewModelPropertyNumber name="downs" id="0:44"/>
        <ViewModelPropertyNumber name="moves" id="0:45"/>
        <ViewModelPropertyNumber name="ups" id="0:46"/>
        <ViewModelPropertyNumber name="exits" id="0:47"/>
        <ViewModelPropertyBoolean name="covered" id="0:49"/>
        <ViewModelPropertyBoolean name="hit" id="0:50"/>
        <ViewModelInstance name="Default" id="0:48">
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:41"/>
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:42"/>
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:43"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:44"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:45"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:46"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:47"/>
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:49"/>
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:50"/>
        </ViewModelInstance>
    </ViewModel>
