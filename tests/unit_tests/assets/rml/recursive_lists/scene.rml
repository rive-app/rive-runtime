<Rive version="1" kind="fragment">
    <!-- Lists whose rows host lists that lead back to them. Every list is
         named "Rows". Each host artboard binds its own view model and has a
         state machine, so a test can load it the way list_row_reuse does. -->

    <!-- Feed: a Card row's list is bound to Feed.cards, a path the Card
         instance doesn't have, so it resolves through the parent context to
         the list that made the row. Unchecked, each Card holds every Card. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:60" viewModelInstanceId="0:61" width="400" height="600" styleId="0:5" name="Feed" id="0:2">
        <LayoutComponentStyle name="Feed Style" id="0:5"/>
        <LayoutComponent width="400" height="600" styleId="0:11" name="List" id="0:10">
            <LayoutComponentStyle flexDirectionValue="column" name="Feed List Style" id="0:11"/>
            <ArtboardComponentList name="Rows" id="0:12">
                <DataBindContext sourcePathIds="0:60-0:62" propertyKey="800"/>
            </ArtboardComponentList>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <Artboard viewModelId="0:50" width="360" height="80" styleId="0:35" x="500" name="Card" id="0:30">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Card Style" id="0:35"/>
        <LayoutComponent width="360" height="80" styleId="0:41" name="Inner" id="0:40">
            <LayoutComponentStyle flexDirectionValue="column" name="Card List Style" id="0:41"/>
            <ArtboardComponentList name="Rows" id="0:42">
                <DataBindContext sourcePathIds="0:60-0:62" propertyKey="800"/>
            </ArtboardComponentList>
        </LayoutComponent>
    </Artboard>

    <!-- Chain: a Link row lists its own count of Links through the same
         NumberToList converter. Every row's items are new default instances,
         so only the nesting depth stops it. -->
    <Artboard defaultStateMachineId="0:207" viewModelId="0:110" viewModelInstanceId="0:112" width="400" height="600" styleId="0:205" y="700" name="Chain" id="0:202">
        <LayoutComponentStyle name="Chain Style" id="0:205"/>
        <LayoutComponent width="400" height="600" styleId="0:211" name="List" id="0:210">
            <LayoutComponentStyle flexDirectionValue="column" name="Chain List Style" id="0:211"/>
            <ArtboardComponentList name="Rows" id="0:212">
                <DataBindContext sourcePathIds="0:110-0:111" propertyKey="800" converterId="0:80"/>
            </ArtboardComponentList>
        </LayoutComponent>
        <StateMachine name="State Machine 1" id="0:207">
            <StateMachineLayer name="Layer 1" id="0:208">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <Artboard viewModelId="0:100" width="360" height="80" styleId="0:235" x="500" y="700" name="Link" id="0:230">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Link Style" id="0:235"/>
        <LayoutComponent width="360" height="80" styleId="0:241" name="Inner" id="0:240">
            <LayoutComponentStyle flexDirectionValue="column" name="Link List Style" id="0:241"/>
            <ArtboardComponentList name="Rows" id="0:242">
                <DataBindContext sourcePathIds="0:100-0:101" propertyKey="800" converterId="0:80"/>
            </ArtboardComponentList>
        </LayoutComponent>
    </Artboard>

    <!-- Forest: a Node row lists its children as Node rows. Its data ends,
         three levels down, and every level has to be built. -->
    <Artboard defaultStateMachineId="0:307" viewModelId="0:130" viewModelInstanceId="0:132" width="400" height="600" styleId="0:305" y="1400" name="Forest" id="0:302">
        <LayoutComponentStyle name="Forest Style" id="0:305"/>
        <LayoutComponent width="400" height="600" styleId="0:311" name="List" id="0:310">
