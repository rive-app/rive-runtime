    <!-- Shelf: a Page row lists Shelf.pages again, through the parent
         context, but a map rule shows them as Tabs, which list nothing. The
         same list nested in its own rows is fine when the rows differ. -->
    <Artboard defaultStateMachineId="0:407" viewModelId="0:150" viewModelInstanceId="0:152" width="400" height="600" styleId="0:405" y="2100" name="Shelf" id="0:402">
