    <!-- Wall: a Tile row's list is bound to Wall.tiles through the parent
         context, like Feed's Cards, but it virtualizes. Its rows are made by
         layout passes after the Tile's own build, and a refused one is
         tried again on every pass. -->
    <Artboard defaultStateMachineId="0:607" viewModelId="0:700" viewModelInstanceId="0:702" width="400" height="600" styleId="0:605" y="3500" name="Wall" id="0:602">
