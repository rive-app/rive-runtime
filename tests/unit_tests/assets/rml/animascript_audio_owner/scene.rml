<Rive version="1" kind="fragment">
<!-- Main: a Node script plays the "what" sound from init and from its first
     advance. Host: a Node script makes its own instance of Main and plays the
     sound itself after each of the instance's hooks. wasm_script_audio_test
     checks each sound stops with the artboard whose script started it.
     Setter and Listener share the Game view model: Setter sets score from its
     own advance and Listener plays the sound when it changes. Decoder plays
     the sound once the host has decoded it into a blob. Tuner plays the
     sound from the setter of its level input. -->
<Artboard width="100" height="100" name="Main" id="0:2">
    <ScriptedDrawable scriptAssetId="0:80" name="Player" id="0:12"/>
</Artboard>
