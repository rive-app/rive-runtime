    <Artboard defaultStateMachineId="7:7" x="1800" width="200" height="300" isComponent="true" viewModelId="9:1" styleId="7:5" name="Row" id="7:2">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Artboard Style" id="7:5"/>
        <ElasticScrollPhysics name="Physics" id="7:90"/>
        <LayoutComponent width="200" height="300" clip="true" styleId="7:11" name="Viewport" id="7:10">
            <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Viewport Style" id="7:11"/>
            <Fill name="Fill"><SolidColor colorValue="FF20242B" name="C"/></Fill>
            <LayoutComponent width="200" styleId="7:13" name="Content" id="7:12">
                <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="hug" name="Content Style" id="7:13"/>
                <ScrollConstraint directionValue="vertical" physicsId="7:90" name="Scroll" id="7:14"/>
                <LayoutComponent width="200" height="1000" styleId="7:21" name="Long" id="7:20">
