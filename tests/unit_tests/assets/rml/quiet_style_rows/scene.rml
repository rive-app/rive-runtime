<Rive version="1" kind="fragment">
    <!--
      Source markup for assets/quiet_style_rows.riv. Rebuild the .riv from
      this file with the CLI, from a directory holding this scene.rml, a
      rive.yaml naming it and Inter.ttf (a copy of
      assets/fonts/Inter_18pt-Regular.ttf), then copy
      build/quiet_style_rows.riv into assets/.

          rive . --unsigned-riv

      What it is for: quiet list rows whose texts use global text styles that
      have work of their own (see quiet_rows_test.cpp). Each Row draws four
      texts, each with its own instances of a style:
      - Label: Current, a style with a state machine. Its `active` input is
        bound to the item's `current`; entering a state writes a Theme color
        into the style's ink.
      - Note: Themed, a style with no state machine, inked straight from the
        Theme global view model.
      - Press: Pressable, a style whose state machine listens to the runs
        drawn with it; a press keys its color red.
      - Runs: its runs are the item's `runs`, each naming Visited, a style
        with a state machine, so each run gets an instance of its own (on
        demand). Its machine reads the run's `visited`, past the style's own
        view model, and the style's `strong` input, which each run's instance
        copies from the Text's handle, bound to the item's `current`.
    -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" width="300" height="300" styleId="0:5" name="Main" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <LayoutComponent width="300" height="300" styleId="0:11" name="List" id="0:10">
            <LayoutComponentStyle flexDirectionValue="column" name="List Style" id="0:11"/>
            <ArtboardComponentList name="Rows" id="0:12">
                <DataBindContext sourcePathIds="0:40-0:42" propertyKey="800"/>
            </ArtboardComponentList>
        </LayoutComponent>
        <StateMachine name="Main Machine" id="0:7">
            <StateMachineLayer name="Layer" id="0:8">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="0:20"/>
                </EntryState>
                <AnimationState x="100" animationId="0:15" id="0:20"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="0:15"/>
    </Artboard>

    <!-- A row: four texts, each drawn with one of the styles below. Its
         machine does nothing but pass pointers on to Press's style. -->
    <Artboard isComponent="true" defaultStateMachineId="0:60" viewModelId="0:50" x="400" width="300" height="90" styleId="0:35" name="Row" id="0:30">
        <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed" name="Row Style" id="0:35"/>
        <Text sizingValue="2" width="90" height="40" x="0" y="10" name="Label" id="0:31">
            <TextValueRun styleId="0:32" text="label" name="Run"/>
            <TextStyleGlobal artboardId="1:2" name="Current Style" id="0:32">
                <ViewModelInstance viewModelId="1:40" exports="true" name="Current Values" id="0:33">
                    <ViewModelInstanceBoolean viewModelPropertyId="1:41">
                        <DataBindContext sourcePathIds="0:50-0:51" propertyKey="593"/>
                    </ViewModelInstanceBoolean>
                    <ViewModelInstanceColor propertyValue="FF000000" viewModelPropertyId="1:42"/>
                </ViewModelInstance>
            </TextStyleGlobal>
        </Text>
        <Text sizingValue="2" width="90" height="40" x="100" y="10" name="Note" id="0:36">
            <TextValueRun styleId="0:37" text="note" name="Run"/>
            <TextStyleGlobal artboardId="2:2" name="Themed Style" id="0:37"/>
        </Text>
        <Text sizingValue="2" width="90" height="40" x="200" y="10" name="Press" id="0:38">
            <TextValueRun styleId="0:39" text="press" name="Run"/>
            <TextStyleGlobal artboardId="3:2" name="Pressable Style" id="0:39"/>
        </Text>
        <Text sizingValue="2" width="290" height="35" x="0" y="50" name="Runs" id="0:90">
            <TextStylePaint fontSize="20" fontAssetId="0:16" name="Runs Paint" id="0:91">
                <Fill>
                    <SolidColor colorValue="FFFFFFFF"/>
                </Fill>
            </TextStylePaint>
            <TextStyleGlobal artboardId="5:2" name="Visited Style" id="0:92">
                <ViewModelInstance viewModelId="5:40" exports="true" name="Visited Values" id="0:93">
                    <ViewModelInstanceBoolean viewModelPropertyId="5:41">
                        <DataBindContext sourcePathIds="0:50-0:51" propertyKey="593"/>
                    </ViewModelInstanceBoolean>
                </ViewModelInstance>
            </TextStyleGlobal>
            <DataBindContext sourcePathIds="0:50-0:52" propertyKey="932"/>
        </Text>
        <StateMachine name="Row Machine" id="0:60">
            <StateMachineLayer name="Layer" id="0:61">
                <AnyState x="0" y="-100"/>
                <ExitState x="200" y="-100"/>
                <EntryState>
                    <StateTransition stateToId="0:62"/>
                </EntryState>
                <AnimationState x="100" animationId="0:65" id="0:62"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation duration="1" name="idle" id="0:65"/>
    </Artboard>
    <ComponentAsset artboardId="0:30" name="Row"/>

    <!-- Current: idle | active, each writing a Theme color into the ink as
