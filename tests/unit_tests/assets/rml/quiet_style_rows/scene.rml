                </AnimationState>
                <AnimationState x="400" y="0" animationId="1:20" id="1:13">
                    <ListenerViewModelChange fromViewModelProperty="true" fromDataBindId="1:31">
                        <BindablePropertyColor>
                            <DataBindContext sourcePathIds="4:1-4:11" propertyKey="638" id="1:31"/>
                            <DataBindContext sourcePathIds="1:40-1:42" propertyKey="638" direction="true"/>
